pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'weather-app'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
        DOCKER_REGISTRY = 'ghcr.io' // GitHub Container Registry
        DOCKER_REPO = 'shaikmukhtarbasha/cicd_weatherapp'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                git branch: 'main',
                    url: 'https://github.com/ShaikMukhtarBasha/cicd_weatherApp.git',
                    credentialsId: 'github-credentials'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                bat """
                    docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% .
                    docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %DOCKER_IMAGE%:latest
                """
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running application tests...'
                bat """
                    REM Start the container for testing
                    docker run -d --name weather-app-test-%BUILD_NUMBER% -p 3001:3000 %DOCKER_IMAGE%:%DOCKER_TAG%

                    REM Wait for the application to start
                    timeout /t 15 /nobreak > nul

                    REM Run basic health check
                    curl -f --max-time 10 http://localhost:3001
                    if %errorlevel% neq 0 exit /b 1

                    REM Stop and remove test container
                    docker stop weather-app-test-%BUILD_NUMBER%
                    docker rm weather-app-test-%BUILD_NUMBER%
                """
            }
        }

        stage('Push to Registry') {
            steps {
                echo 'Pushing Docker image to GitHub Container Registry...'
                bat """
                    REM Login to GitHub Container Registry
                    echo %GITHUB_TOKEN% | docker login ghcr.io -u %GITHUB_USER% --password-stdin

                    REM Create full image names
                    set FULL_IMAGE_TAG=%DOCKER_REGISTRY%/%DOCKER_REPO%/%DOCKER_IMAGE%:%DOCKER_TAG%
                    set FULL_IMAGE_LATEST=%DOCKER_REGISTRY%/%DOCKER_REPO%/%DOCKER_IMAGE%:latest

                    REM Tag images
                    docker tag %DOCKER_IMAGE%:%DOCKER_TAG% %FULL_IMAGE_TAG%
                    docker tag %DOCKER_IMAGE%:latest %FULL_IMAGE_LATEST%

                    REM Push images
                    docker push %FULL_IMAGE_TAG%
                    docker push %FULL_IMAGE_LATEST%
                """
            }
        }

        stage('Deploy to Production') {
            steps {
                echo 'Deploying to production environment...'
                bat """
                    REM Stop existing container
                    docker stop weather-app-prod 2>nul
                    docker rm weather-app-prod 2>nul

                    REM Pull latest image
                    docker pull %DOCKER_REGISTRY%/%DOCKER_REPO%/%DOCKER_IMAGE%:%DOCKER_TAG%

                    REM Run new container
                    docker run -d ^
                        --name weather-app-prod ^
                        -p 3000:3000 ^
                        --restart unless-stopped ^
                        --label "app=weather-app" ^
                        --label "version=%DOCKER_TAG%" ^
                        %DOCKER_REGISTRY%/%DOCKER_REPO%/%DOCKER_IMAGE%:%DOCKER_TAG%
                """
            }
        }

        stage('Post-Deployment Verification') {
            steps {
                echo 'Verifying production deployment...'
                bat """
                    REM Wait for deployment
                    timeout /t 10 /nobreak > nul

                    REM Verify the application is running
                    curl -f --max-time 10 http://localhost:3000
                    if %errorlevel% neq 0 exit /b 1

                    echo ✅ Deployment verification successful!
                """
            }
        }
    }

    post {
        always {
            echo 'Cleaning up Docker resources...'
            bat """
                REM Remove build images
                docker rmi %DOCKER_IMAGE%:%DOCKER_TAG% 2>nul
                docker rmi %DOCKER_IMAGE%:latest 2>nul

                REM Clean up dangling resources
                docker system prune -f
            """
        }
        success {
            echo '🎉 CI/CD pipeline completed successfully!'
            echo "🌐 Application is running at http://localhost:3000"
        }
        failure {
            echo '❌ CI/CD pipeline failed!'
            // Send notification (configure email/Slack in Jenkins)
        }
    }
}